# Server
PORT=8080
ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL_MODE=disable

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback do BACKEND xử lý (Next.js chỉ redirect người dùng tới đây)
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Sau khi login xong, backend sẽ redirect trình duyệt về URL này kèm token
# (dùng cho flow web; mobile app sẽ gọi API khác, xem README)
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback